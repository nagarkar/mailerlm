# Copy to .env (gitignored). Vendor keys keep the vendor's name; values here are placeholders.
# Where each is used: delivery (Resend), inbox reply classifier (TypeSafe / Jev).
RESEND_API_KEY=
TYPESAFE_API_KEY=
# The template editor's model vendor (ANTHROPIC_API_KEY for claude, GEMINI_API_KEY for gemini): the vendor is the model name's prefix in config.toml.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# mailerlm's own Gmail OAuth client (Desktop app, Gmail API enabled); same names as supplylm, own values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# peoplelm, the people service (contacts and consent live there): its local address, e.g. http://127.0.0.1:<port>.
# The port is this Mac's and never enters git; `peoplelm doctor` checks the service.
PEOPLELM_URL=
# mailerlm:begin  (written only by `mailerlm setup`)
MAILERLM_WORKSPACE=
# mailerlm:end
