<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f6f6f4;">
{% if preview_text %}<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ preview_text }}</div>{% endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f4;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;">
<tr><td style="padding:28px 32px;font-family:Georgia,'Times New Roman',serif;font-size:17px;color:#1d1d1d;">
{{ body_html | safe }}
</td></tr>
<tr><td style="padding:16px 32px 28px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#777;border-top:1px solid #e6e6e6;">
{{ unsubscribe_line }}<br>
{{ sender_name }}, {{ postal_address }}
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
